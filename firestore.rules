rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /games/{gameCode} {

      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.pot == 0
        && (request.auth.uid in request.resource.data.players)
        && request.resource.data.players[request.auth.uid].status == 'approved';

      allow update: if request.auth != null && (
        isHostUpdate(request.auth.uid, resource.data, request.resource.data)
        || isApprovedPlayerUpdate(request.auth.uid, resource.data, request.resource.data)
        || isJoiningPlayer(request.auth.uid, resource.data, request.resource.data)
        || isLeavingPlayer(request.auth.uid, resource.data, request.resource.data)
      );

      allow delete: if false;
    }

    function isHostUpdate(uid, existingData, newData) {
      let isGameHost = existingData.hostId == uid;
      let changedKeys = newData.diff(existingData).changedKeys();

      let approvingPlayer = changedKeys.hasOnly(['players'])
        && newData.players.diff(existingData.players).changedKeys().size() == 1;

      let startingGame = changedKeys.hasOnly(['status'])
        && existingData.status == 'lobby'
        && newData.status == 'active';

      let pausingGame = changedKeys.hasOnly(['status'])
        && existingData.status == 'active'
        && newData.status == 'paused';

      let resumingGame = changedKeys.hasOnly(['status'])
        && existingData.status == 'paused'
        && newData.status == 'active';

      let endingGame = (changedKeys.hasOnly(['status']) || changedKeys.hasOnly(['status', 'endedAt']))
        && newData.status == 'ended';

      return isGameHost && (approvingPlayer || startingGame || pausingGame || resumingGame || endingGame);
    }

    function isApprovedPlayerUpdate(uid, existingData, newData) {
      let isPlayerApproved = (uid in existingData.players)
        && existingData.players[uid].status == 'approved';
      let changedKeys = newData.diff(existingData).changedKeys();

      let isBetting = changedKeys.hasOnly(['pot', 'players'])
        && newData.players.diff(existingData.players).changedKeys().hasOnly([uid])
        && newData.pot >= existingData.pot;

      let isTakingPot = changedKeys.hasOnly(['pot', 'round', 'players'])
        && newData.pot == 0
        && newData.round == existingData.round + 1;

      return isPlayerApproved && (isBetting || isTakingPot);
    }

    function isJoiningPlayer(uid, existingData, newData) {
      let changedKeys = newData.diff(existingData).changedKeys();
      let playerKeys = newData.players.diff(existingData.players).changedKeys();

      return !(uid in existingData.players)
        && (uid in newData.players)
        && newData.players[uid].status == 'pending'
        && existingData.status == 'lobby'
        && changedKeys.hasOnly(['players'])
        && playerKeys.hasOnly([uid]);
    }

    function isLeavingPlayer(uid, existingData, newData) {
      let changedKeys = newData.diff(existingData).changedKeys();
      let playerKeys = newData.players.diff(existingData.players).changedKeys();

      return (uid in existingData.players)
        && !(uid in newData.players)
        && existingData.status == 'lobby'
        && existingData.hostId != uid
        && changedKeys.hasOnly(['players'])
        && playerKeys.hasOnly([uid]);
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /gameHistory/{gameCode} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
