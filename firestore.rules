rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /games/{gameCode} {

      // Allow get for any authenticated user (needed for join flow)
      // But disallow list to prevent enumeration of all games
      allow get: if request.auth != null;
      allow list: if false;

      // Only authenticated users can create a game, as the host
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.pot == 0
        && request.resource.data.players[request.auth.uid] != null
        && request.resource.data.players[request.auth.uid].status == 'approved';

      // Updates are allowed for authenticated users with a valid role
      allow update: if request.auth != null && (
        isHostUpdate(request.auth.uid, resource.data, request.resource.data)
        || isApprovedPlayerUpdate(request.auth.uid, resource.data, request.resource.data)
        || isJoiningPlayer(request.auth.uid, resource.data, request.resource.data)
        || isLeavingPlayer(request.auth.uid, resource.data, request.resource.data)
      );

      // Games are never deleted — they end with status: 'ended'
      allow delete: if false;
    }

    function isHost(uid, data) {
      return data.hostId == uid;
    }

    function isApprovedPlayer(uid, data) {
      return data.players[uid] != null
        && data.players[uid].status == 'approved';
    }

    // Host can approve players, change game status, and modify pot/round during take-pot
    function isHostUpdate(uid, existingData, newData) {
      let isGameHost = existingData.hostId == uid;
      let changedKeys = newData.diff(existingData).changedKeys();

      // Host can approve players (change player.X.status from pending to approved)
      let approvingPlayer = changedKeys.hasOnly(['players'])
        && newData.players.diff(existingData.players).changedKeys().size() == 1;

      // Host can start game (change status from lobby to active)
      let startingGame = changedKeys.hasOnly(['status'])
        && existingData.status == 'lobby'
        && newData.status == 'active';

      // Host can end game (change status to ended)
      let endingGame = changedKeys.hasOnly(['status'])
        && newData.status == 'ended';

      return isGameHost && (approvingPlayer || startingGame || endingGame);
    }

    // Approved players can only update their own balance/currentBet and the pot
    function isApprovedPlayerUpdate(uid, existingData, newData) {
      let isPlayerApproved = existingData.players[uid] != null
        && existingData.players[uid].status == 'approved';
      let changedKeys = newData.diff(existingData).changedKeys();

      // Player betting: can update pot, round, and their own player fields
      let isBetting = changedKeys.hasOnly(['pot', 'players'])
        && newData.players.diff(existingData.players).changedKeys().hasOnly([uid])
        && newData.pot >= existingData.pot;

      // Player taking pot: can update pot, round, and all players' currentBet/balance
      let isTakingPot = changedKeys.hasOnly(['pot', 'round', 'players'])
        && newData.pot == 0
        && newData.round == existingData.round + 1;

      return isPlayerApproved && (isBetting || isTakingPot);
    }

    // A new player joining adds only themselves with pending status
    function isJoiningPlayer(uid, existingData, newData) {
      let changedKeys = newData.diff(existingData).changedKeys();
      let playerKeys = newData.players.diff(existingData.players).changedKeys();

      return existingData.players[uid] == null
        && newData.players[uid] != null
        && newData.players[uid].status == 'pending'
        && existingData.status == 'lobby'
        && changedKeys.hasOnly(['players'])
        && playerKeys.hasOnly([uid]);
    }

    // A player (pending or approved) can remove themselves from lobby
    function isLeavingPlayer(uid, existingData, newData) {
      let changedKeys = newData.diff(existingData).changedKeys();
      let playerKeys = newData.players.diff(existingData.players).changedKeys();

      return existingData.players[uid] != null
        && !(uid in newData.players)
        && existingData.status == 'lobby'
        && existingData.hostId != uid
        && changedKeys.hasOnly(['players'])
        && playerKeys.hasOnly([uid]);
    }
  }
}
